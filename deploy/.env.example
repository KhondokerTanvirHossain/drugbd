DB_USER=bddrug
# DB_PASSWORD: alphanumeric only (no $, quotes or spaces); compose interpolates this file
DB_PASSWORD=change-me
# Set by the deploy workflow on every run; must exist as a line.
IMAGE_TAG=latest
# Lowercase GitHub owner of the GHCR images
GHCR_OWNER=khondokertanvirhossain
# Shared proxy network of the Caddy stack (~/n8n)
EDGE_NETWORK=n8n_edge

# --- Reviewer sign-in (see README "Reviewer sign-in setup") ---
# Secrets. Required: web and api refuse to start without them, and deploy refuses to run.
# Generate each with: openssl rand -hex 32   (hex only, so compose needs no quoting)
SESSION_SECRET=
INTERNAL_API_TOKEN=
# Secret from the Cloudflare Turnstile widget. Empty = every review/flag action is refused.
TURNSTILE_SECRET_KEY=
# Public Firebase web config and Turnstile site key. Use the same values as the GitHub repo
# variables FIREBASE_PROJECT_ID, FIREBASE_API_KEY, FIREBASE_AUTH_DOMAIN, FIREBASE_APP_ID and
# TURNSTILE_SITE_KEY. Empty values leave sign-in disabled.
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
# drugdb.eliooo.org once the Google OAuth redirect URI below is added (README "Firebase auth domain").
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=drugdb.eliooo.org
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Reviewer allowlist: comma-separated email:role pairs, role = pharmacist | engineer, no spaces.
# Example: REVIEWERS=alice@example.com:pharmacist,bob@example.com:engineer
# Reviewer emails are personal data: they live only in this file on the host.
REVIEWERS=

# --- IntelliDrugs (P1A) ---
# Public host name. Required: the web server refuses to start without it and deploy refuses to run.
SITE_HOST=drugdb.eliooo.org
# Landing page hero product (spec §6.1).
HERO_CONCEPT_ID=186-0030-006--napa

# --- QA API (spec §7.9; docs/runbooks/qa-api-keys.md) ---
# Read-only, key-gated QA API at /api/qa/v1/*. These are the env keys; QA team members also create their own DB keys on
# /review/qa (spec §7.10). Empty = no env keys: a request no key authenticates answers 401.
# Comma-separated label:sha256hex pairs, no spaces; label = a-z 0-9 _ - (up to 32, starting with a letter or digit).
# Only the SHA-256 hash of each key goes here, never the key itself. Make a key and its hash with:
#   KEY=$(openssl rand -hex 32); printf %s "$KEY" | sha256sum | cut -d' ' -f1     (macOS: shasum -a 256 for sha256sum)
# Example: QA_API_KEYS=qa-checker:<64 lower-case hex>
QA_API_KEYS=
